<header>
  <nav id="navbar" class="navbar navbar-light {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}{% if page.permalink == '/' %} d-none{% endif %}" role="navigation">
    <div class="container" style="display: flex; justify-content: flex-start; align-items: center; gap: 0.75rem;">
      {% if page.permalink != '/' %}
        <a href="{{ site.baseurl }}/" style="font-size: 1.1rem; text-decoration: none; color: var(--global-text-color);" title="Home">
          <i class="fa-solid fa-house"></i>
        </a>
        <a href="#" style="font-size: 1.1rem; text-decoration: none; color: var(--global-text-color);" onclick="
          var html = document.documentElement;
          html.classList.remove('transition');
          var current = html.getAttribute('data-theme');
          var next = current === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-theme', next);
          html.setAttribute('data-theme-setting', next);
          localStorage.setItem('theme', next);
          return false;
        " title="Toggle dark mode">
          <i class="fa-solid fa-circle-half-stroke"></i>
        </a>
      {% endif %}
    </div>
  </nav>
</header>
